# AI Provider Configuration
# AI_PROVIDER: Which provider to use
# Options: bedrock, openai, anthropic, google, openrouter
# Default: bedrock
AI_PROVIDER=bedrock

# AI_MODELS: Comma-separated list of available models (REQUIRED)
# First model is the default. Users can switch between models in the UI.
AI_MODELS=global.anthropic.claude-sonnet-5-5,global.anthropic.claude-opus-5-5,global.anthropic.claude-sonnet-5

# AWS Bedrock Configuration
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key  # Alternative: use Bedrock API key instead of AK/SK
# Note: Claude and Nova models support reasoning/extended thinking
# Claude 4.7+/5.x (e.g. Sonnet 5, Opus 4.8) use adaptive thinking with a
# summarized (readable) trace, ENABLED BY DEFAULT — the model scales thinking
# to task difficulty, so simple edits stay cheap.
# BEDROCK_REASONING_EFFORT=medium        # Optional: default thinking effort for Claude 4.7+ (low|medium|high|xhigh|max), overridable per request in the UI. Defaults to "medium" - "high" and above can spend the whole output budget thinking. Also sets Nova effort (low|medium|high).
# BEDROCK_REASONING_BUDGET_TOKENS=12000  # Optional: legacy thinking budget for Claude <= 4.6 (1024-64000)

# OpenAI Configuration
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: Custom OpenAI-compatible endpoint
# OPENAI_ORGANIZATION=org-...  # Optional
# OPENAI_PROJECT=proj_...      # Optional
# Note: o1/o3/gpt-5 models automatically enable reasoning summary (default: detailed)
# OPENAI_REASONING_EFFORT=low   # Optional: Reasoning effort (minimal/low/medium/high) - for o1/o3/gpt-5
# OPENAI_REASONING_SUMMARY=detailed  # Optional: Override reasoning summary (none/brief/detailed)

# Anthropic (Direct) Configuration
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://your-custom-anthropic/v1
# ANTHROPIC_THINKING_TYPE=enabled            # Optional: Anthropic extended thinking (enabled)
# ANTHROPIC_THINKING_BUDGET_TOKENS=12000     # Optional: Budget for extended thinking in tokens

# Google Generative AI Configuration
# GOOGLE_GENERATIVE_AI_API_KEY=...
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta  # Optional: Custom endpoint
# GOOGLE_CANDIDATE_COUNT=1                   # Optional: Number of candidates to generate
# GOOGLE_TOP_K=40                            # Optional: Top K sampling parameter
# GOOGLE_TOP_P=0.95                          # Optional: Nucleus sampling parameter
# Note: Gemini 2.5/3 models automatically enable reasoning display (includeThoughts: true)
# GOOGLE_THINKING_BUDGET=8192                # Optional: Gemini 2.5 thinking budget in tokens (for more/less thinking)
# GOOGLE_THINKING_LEVEL=high                 # Optional: Gemini 3 thinking level (low/high)

# OpenRouter Configuration
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # Optional: Custom endpoint

# Langfuse Observability (Optional)
# Enable LLM tracing and analytics - https://langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASEURL=https://cloud.langfuse.com  # EU region, use https://us.cloud.langfuse.com for US

# Temperature (Optional)
# Controls randomness in AI responses. Lower = more deterministic.
# Leave unset for models that don't support temperature (e.g., GPT-5.1 reasoning models)
# TEMPERATURE=0

# Max Output Tokens (Optional)
# Maximum tokens the model can generate per response. Default: 64000.
# Larger diagrams need more tokens; too low causes "Output was truncated" errors.
# Claude 4.x supports up to 64000. If reasoning/thinking is enabled, this must be
# larger than the reasoning budget (thinking tokens count against the output).
# MAX_OUTPUT_TOKENS=64000

# App Base URL (Optional)
# Public URL of this deployment, e.g. https://autodraw.example.com
# When set, agent/MCP responses include a `viewUrl` link that opens the
# generated diagram rendered in this app.
# APP_BASE_URL=https://autodraw.example.com

# Access Control (Optional)
# ACCESS_CODE=your-secret-code

# Draw.io Configuration (Optional, build-time: rebuild after changing)
# EMBED_DRAWIO_BASE_URL=https://drawio.example.com  # Self-hosted draw.io; empty uses https://embed.diagrams.net
# Also used by /render/<id>, which loads <url>/js/viewer-static.min.js (default https://viewer.diagrams.net)

# Subdirectory Deployment (Optional, build-time: rebuild after changing)
# For deploying to a subdirectory (e.g., https://example.com/nextaidrawio)
# Set this to your subdirectory path with leading slash (e.g., /nextaidrawio)
# Leave empty for root deployment (default)
# AUTO_BASE_PATH=/nextaidrawio

# PDF Input Feature (Optional)
# Enable PDF file upload to extract text and generate diagrams
# Enabled by default. Set to "false" to disable.
# ENABLE_PDF_INPUT=true
# NEXT_PUBLIC_MAX_EXTRACTED_CHARS=150000  # Max characters for PDF/text extraction (default: 150000)

# Tavily Search API (Optional)
# Enables the web_search tool for the AI to search the web for current info.
# Web content extraction (web_extract) is now built-in and needs no API key.
# Get your API key from https://tavily.com
# Free tier: 1000 searches/month
# TAVILY_API_KEY=tvly-...
